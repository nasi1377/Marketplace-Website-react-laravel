    use Sms;

    public function products()
    {
        $products = Product::orderBy('id', 'DESC')->paginate(10);
        $vip_products = Product::whereVip(1)->orderBy('id', 'DESC')->paginate(5);
        return view('products', compact('products', 'vip_products'));
    }

    public function shopCart(Request $request)
    {
        $cart = [];
        if($request->cookie('cart')) {
            $cart = json_decode($request->cookie('cart'), true);
        }
        return view('shop-cart', compact('cart'));
    }

    public function shopCartRemove($slug, Request $request)
    {
        $cart = [];
        if($request->cookie('cart')) {
            
            $cart = json_decode($request->cookie('cart'), true);
            unset($cart[$slug]);

        }

        return back()->withCookie(cookie('cart', json_encode($cart), 120));
    }

    public function cartPayment(Request $request)
    {
        $cart = [];
        $totalPrice = 0;
        $orders_ids = '';
        if($request->cookie('cart')) {
            $cart = json_decode($request->cookie('cart'), true);
            if(count($cart)) {
                $first = true;
                foreach ($cart as $item) {
                    $product = Product::where('id', $item['product_id'])->first();
                    $id_order = ProductOrder::insertGetId([
                        'author_id' => Auth::id(),
                        'product_id' => $item['product_id'],
                        'count' => $item['count'],
                        'weight' => $item['weight'],
                        'price' => $product->price,
                        'created_at' => Carbon::now()
                    ]);
                    if($first) {
                        $orders_ids = $id_order;
                        $first = false;
                    } else {
                        $orders_ids .= '-' . $id_order;
                    }

                    
                    $totalPrice +=  ( $item['count'] * $item['weight'])* $product->price ;
                    
                    //$send_price = ((int) setting('site.sendprice')) * ( $item['count'] * $item['weight']);

                    $send_price = ((int) setting('site.sendprice')) +  (  $item['count'] * $item['weight'] ) * 3000;


                    $totalPrice +=$send_price;

                }
            }
        }

           // $send_price = (int) setting('site.sendprice');
          //  $totalPrice +=   $send_price;

        $cookie = \Cookie::forget('cart');
        return $this->payment($totalPrice,$orders_ids)->withCookie($cookie);
        

